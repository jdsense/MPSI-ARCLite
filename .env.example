# ==============================================================================
# [MPSI 시스템] 분산 독립 인스턴스 배포용 환경변수 템플릿 (.env.example)
# ==============================================================================
# 본 시스템은 동일한 단일 소스코드를 기반으로 MPSI 본사, 우성정공, 뉴몰드에 각각 설치됩니다.
# 각 설치 서버의 환경에 맞추어 아래 변수값을 설정하십시오.

# ------------------------------------------------------------------------------
# 1. 노드 정체성 (Node Identity)
# ------------------------------------------------------------------------------
# [배포 유형 옵션]
# - HQ          : MPSI 본사 총괄 허브 인스턴스
# - VENDOR_MOLD : 우성정공(주) 금형제작 독립 인스턴스
# - VENDOR_MASS : (주)뉴몰드 사출양산 독립 인스턴스
NEXT_PUBLIC_NODE_TYPE="HQ"

# [노드 식별 코드]
# - MPSI_HQ | WOOSUNG_MOLD | NEWMOLD_MASS
NEXT_PUBLIC_NODE_ID="MPSI_HQ"

# [노드 기관/업체 공식 표기명]
# - MPSI 본사 | 우성정공(주) | (주)뉴몰드
NEXT_PUBLIC_NODE_NAME="MPSI 본사"
PORT=3003

# ------------------------------------------------------------------------------
# 2. 분산 독립 DB 간 API 연계 설정
# ------------------------------------------------------------------------------
# MPSI Hub 연계 API 주소 (우성정공 / 뉴몰드 인스턴스에서 MPSI로 데이터 전송 시 사용)
NEXT_PUBLIC_HUB_API_URL="https://mpsi-hub.a2lab.co.kr/api/v1/sync"

# 노드 간 보안 인증 키 (mTLS / HMAC 서명용)
NODE_API_KEY="CHANGE_ME_node_api_key"
NODE_HMAC_SECRET="CHANGE_ME_hmac_secret"

# ------------------------------------------------------------------------------
# 3. 로컬 독립 데이터베이스 (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://mpsi_user:mpsi_secure_pwd@localhost:5432/mpsi_db?schema=public"


# ------------------------------------------------------------------------------
# 4. ARC-WIZARD AI 바이브 코딩 엔진 설정 (추후 모델/API 변경 가능)
# ------------------------------------------------------------------------------
# 지원 Provider: auto | gemini | vertex | openai-compatible
ARC_WIZARD_PROVIDER="auto"
ARC_WIZARD_MODEL="gemini-2.5-flash"
ARC_WIZARD_API_KEY=""
GEMINI_API_KEY=""
ARC_WIZARD_BASE_URL=""
# 선택: 설정 시 AI 편집 API 가 x-arc-wizard-token 헤더 일치를 요구 (서버 세션 도입 전 임시 보강)
ARC_WIZARD_ADMIN_TOKEN=""
